# ============================================================
# Nobab Lungi — Environment Variables Template
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.
# ============================================================

# ============================================================
# SUPABASE
# Get from: Supabase Dashboard → Settings → API
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key — server-side only, NEVER expose to browser
# Get from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# ============================================================
# CLOUDINARY
# Get from: Cloudinary Dashboard → Settings → Access Keys
# ============================================================

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret


# ============================================================
# APP SETTINGS
# ============================================================

# Base URL of the application (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# SETUP INSTRUCTIONS
# ============================================================
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in your Supabase and Cloudinary credentials
# 3. In Supabase SQL Editor, run these files in order:
#    a. supabase/functions.sql
#    b. supabase/schema.sql
#    c. supabase/rls-policies.sql
#    d. supabase/seed.sql
# 4. Set your admin email:
#    ALTER DATABASE postgres SET app.admin_email = 'your@email.com';
# 5. npm run dev
